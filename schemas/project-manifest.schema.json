{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thaiv.dev/schemas/project-manifest.schema.json",
  "title": "Thaiv Project Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project", "artifact", "health"],
  "properties": {
    "version": { "const": 1 },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug"],
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "buildCommand", "outputDirectory"],
      "properties": {
        "type": { "enum": ["static"] },
        "buildCommand": { "type": "string", "minLength": 1 },
        "outputDirectory": { "type": "string", "minLength": 1 }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "pattern": "^/" }
      }
    }
  }
}
